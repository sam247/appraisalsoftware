# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://ierhoepwoaozxpxyjkje.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — cron / outbox drain only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Public app origin for respondent + invite URLs (no trailing slash).
# Production (verified Vercel domain): https://app.appraisalsoftware.co.uk
# Local: http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=https://app.appraisalsoftware.co.uk
# Optional server-only alias
# APP_ORIGIN=https://app.appraisalsoftware.co.uk

# Resend — use the Appraisal Software API key + verified from-domain
# (do not reuse Disclosurely notifications@disclosurely.com)
RESEND_API_KEY=
RESEND_FROM=Appraisal Software <invites@appraisalsoftware.co.uk>

# Cron / scheduler auth (required in production)
CRON_SECRET=

# Server-only recipient for public contact enquiries
CONTACT_TO_EMAIL=sampettiford@googlemail.com

# Enable only after the hosted trial / GA4 release checks in docs/seo/release.md.
NEXT_PUBLIC_TRIAL_READY=false
NEXT_PUBLIC_GA4_ENABLED=false
